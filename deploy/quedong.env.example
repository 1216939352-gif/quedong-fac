# 鹊动后端环境变量模板
# 复制为 /etc/quedong/quedong.env 并据实修改（systemd 通过 EnvironmentFile 读取）
# 注意：本文件含密钥，权限应设为 600，属主 quedong:quedong

# ── 监听端口（nginx/Caddy 反代目标）──
PORT=8080

# ── 前端静态目录（放 _dl3 的内容，即 npm/构建后的前端）──
# 若由 nginx 直接托管前端，此值仅作为兜底；务必填真实路径
STATIC_DIR=/opt/quedong/frontend

# ── 签名密钥 ──
# 留空 = 首次启动自动生成并写入 server/data/.secret（重启后保持一致）
# 生产环境建议显式设置一个高强度随机串（32+ 字节十六进制），并妥善保管
# SECRET=change-me-to-a-long-random-hex-string-at-least-32-bytes

# ── 备份保留份数（backup.js / /api/admin/backup 使用）──
BACKUP_KEEP=30

# ── 环境标识（可选，便于日志区分）──
NODE_ENV=production

# ── AI 部署拓扑 ──
# 三种：local（仅本地 Ollama）/ cloud（仅云 API）/ hybrid（本地优先，云兜底）
AI_MODE=hybrid
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=1024

# ── 本地模型（Ollama，POST http://localhost:11434）──
AI_LOCAL_URL=http://localhost:11434
AI_LOCAL_MODEL=qwen2.5:7b
# 多模型：AI_LOCAL_MODELS=qwen2.5:7b|通义千问 7B,llama3.1:8b|Llama 3.1 8B

# ── 云端模型（火山方舟 / DeepSeek 等 OpenAI 兼容接口）──
# 默认 baseUrl/key/model
AI_CLOUD_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_CLOUD_API_KEY=<replace-with-your-doubao-api-key>
AI_CLOUD_MODEL=doubao-seed-1-6-250615

# 多模型（豆包 + DeepSeek 联合）：每条 "id|展示名|baseUrl|apiKey"
# AI_CLOUD_MODELS=doubao-seed-1-6-250615|豆包 Pro 1.6|https://ark.cn-beijing.volces.com/api/v3|<doubao-key>,deepseek-chat|DeepSeek V3|https://api.deepseek.com/v1|<deepseek-key>
# 配置后前端下拉菜单会同时显示两个模型，用户可随时切换。
AI_CLOUD_DEFAULT_MODEL=doubao-seed-1-6-250615
