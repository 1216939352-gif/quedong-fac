# 鹊动系统 · AI 能力环境变量（复制为 .env，仅服务端使用，切勿提交）
# 三种拓扑：local（本地Ollama）/ cloud（云API）/ hybrid（混合，本地优先回落云）

# ── 模式 ──
AI_MODE=hybrid

# ── 本地自托管（Ollama，推荐隐私优先）──
# 先安装 ollama 并 `ollama pull qwen2.5:7b`
AI_LOCAL_URL=http://localhost:11434
AI_LOCAL_MODEL=qwen2.5:7b

# ── 云 LLM API（OpenAI 兼容，如 火山方舟/豆包、DeepSeek、通义千问）──
# Key 只存在此处，服务端读取，绝不进前端
# 火山方舟/豆包示例：
AI_CLOUD_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_CLOUD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_CLOUD_MODEL=doubao-seed-1-6-250615
# 多模型选择（2-3 个，逗号分隔，支持 id|展示名；含 | 时必须用英文双引号包裹）；前端浮窗会出现模型下拉框
AI_CLOUD_MODELS="doubao-seed-1-6-250615|豆包Pro, doubao-lite-32k-240828|豆包Lite, doubao-vision-pro-250615|豆包视觉"
AI_CLOUD_DEFAULT_MODEL=doubao-seed-1-6-250615

# ── 通用 ──
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=1024
# AI_SYSTEM_PROMPT=可选：覆盖默认临床辅助系统提示词

# ── HY3 独立模型（手动切换用，OpenAI 兼容云端接口）──
# 在对话框模型下拉中作为独立可选项出现，用户可手动切换；仅在三项齐备时启用。
# 前端浮窗「选择 AI 模型」下拉会列出 HY3，选中后所有对话/方案/解读均走该 endpoint。
AI_HY3_ENABLED=false
AI_HY3_BASE_URL=https://your-hy3-endpoint/v1
AI_HY3_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_HY3_MODEL=hy3
AI_HY3_LABEL=HY3

# ── 图像生成（对话框内「🖼️ 生成配图」用，豆包 Seedream 等）──
# 火山方舟图像接口为 /images/generations，须用「推理接入点 ID」(ep-xxx) 而非模型名。
# 不配或 AI_IMAGE_ENABLED=false 时，前端 🖼️ 按钮调用会优雅返回「未配置」提示。
AI_IMAGE_ENABLED=false
AI_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_IMAGE_MODEL=ep-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 后端服务 ──
PORT=8080
# STATIC_DIR=../_dl3   # 前端构建目录（默认 ../_dl3）
# SECRET=                # 鉴权签名密钥（首次运行自动生成，生产可显式指定）
# BACKUP_KEEP=30
